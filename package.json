{
  "name": "apex-resilience",
  "private": true,
  "version": "0.0.0",
  "description": "Failure classification, safe retry and dead-lettering for Salesforce integrations",
  "scripts": {
    "prettier": "prettier --write \"**/*.{cls,trigger,json,md,yml,yaml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,trigger,json,md,yml,yaml}\"",
    "prepare": "husky || true",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,trigger,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "volta": {
    "node": "24.21.0"
  }
}
