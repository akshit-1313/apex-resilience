# This file is used for Git repositories to specify intentionally untracked files that Git should ignore.
# For useful gitignore templates see: https://github.com/github/gitignore

# Secrets: private keys, certificates and org auth files must never be committed.
# This repo's CI holds a Dev Hub credential; a leaked auth URL is a live login.
*.key
*.pem
*[Aa]uth[Uu]rl*
*[Aa]uth-[Uu]rl*
*[Aa]uth_[Uu]rl*

# Salesforce cache (the CLI stores org auth under these too)
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env
